{
 "name": "dari-workspace",
 "private": true,
 "type": "module",
 "workspaces": [
  "packages/dari-core",
  "packages/dari-model",
  "packages/dari"
 ],
 "engines": {
  "node": ">=24"
 },
 "scripts": {
  "build": "npm run build -w @local/dari",
  "typecheck": "npm run typecheck -w @local/dari-core && npm run typecheck -w @local/dari-model && npm run typecheck -w @local/dari",
  "test": "node tests/run.mjs",
  "check": "npm run typecheck && npm test"
 },
 "devDependencies": {
  "@types/node": "^26.6.4",
  "tsdown": "^0.23.7",
  "typescript": "^7.0.2"
 }
}
