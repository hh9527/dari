{
 "compilerOptions": {
  "target": "ES2023",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "declaration": true,
  "sourceMap": true,
  "rewriteRelativeImportExtensions": true,
  "strict": false,
  "skipLibCheck": true,
  "types": [
   "node"
  ],
